# Absolute path of the source repository OpenCode should inspect.
REPO_PATH=/absolute/path/to/repository

# Absolute host directory for generated complete-file bundles.
BUNDLE_ROOT=/absolute/path/to/opencode-bundles

# Primary GID of the host user who manages bundles. Set to: id -g
HOST_GID=1000

# OpenAI-compatible local model endpoint as seen FROM THE OPENCODE CONTAINER.
# If the model server is on the Docker host, host.docker.internal is available.
QWEN_BASE_URL=http://host.docker.internal:8000/v1
QWEN_MODEL_ID=qwen/qwen3.5
QWEN_API_KEY=local

# Validated baseline for repository-scale review. These values must not exceed
# the limits configured on the model server.
QWEN_CONTEXT_LENGTH=65536
QWEN_OUTPUT_TOKENS=4096

# OpenCode Web UI. The Compose file binds it to 127.0.0.1 only.
OPENCODE_PORT=4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# You may pin this after validating a specific OpenCode release/image.
OPENCODE_IMAGE=ghcr.io/anomalyco/opencode:latest
